DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
SYSTEM_SUGGESTIONS_PROVIDER=auto
SYSTEM_SUGGESTIONS_TIMEOUT_MS=2500

# Shared HTTP admission: 30 requests per requester across ALL surfaces / 60s.
# Required to permit new provider calls; unavailable storage serves verified fallback.
# TLS Redis or Valkey endpoint; vendor-neutral, no localhost production fallback.
REDIS_URL=
SYSTEM_SUGGESTIONS_RATE_LIMIT_NAMESPACE=mgda:preview:system-suggestions:v1
# Production uses mgda:production:system-suggestions:v1; never a run/build ID.
# Same random >=32-character server secret on every instance. Never NEXT_PUBLIC_.
SYSTEM_SUGGESTIONS_IDENTITY_SECRET=
# Set only when your trusted ingress overwrites this single-IP header.
# Empty means a conservative shared anonymous quota; arbitrary X-Forwarded-For is ignored.
SYSTEM_SUGGESTIONS_TRUSTED_IP_HEADER=
