        "export_presets": { "type": "array", "const": ["portrait_card"] },
        "maximum_node_count": { "const": 8 },
        "generic_association_only": { "const": true }
      }
    },
    "ProductionReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "categories",
        "vocabulary",
        "associations",
        "compositions",
        "states",
        "states_by_hash",
        "transitions",
        "capabilities"
      ],
      "properties": {
        "database": { "$ref": "#/$defs/DatabaseRecord" },
