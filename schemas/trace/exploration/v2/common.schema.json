        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "METHOD_NOT_ALLOWED" }, "status": { "const": 405 }, "retryable": { "const": false } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "ACTION_NOT_AVAILABLE" }, "status": { "const": 409 }, "retryable": { "const": false } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "STALE_EXPLORATION_STATE" }, "status": { "const": 409 }, "retryable": { "const": false } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "STATE_DATABASE_VERSION_MISMATCH" }, "status": { "const": 409 }, "retryable": { "const": false } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "NO_EXPORTABLE_COMPOSITION" }, "status": { "const": 409 }, "retryable": { "const": false } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "REQUEST_LIMIT_EXCEEDED" }, "status": { "const": 413 }, "retryable": { "const": false } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "RENDER_CAPACITY_EXCEEDED" }, "status": { "const": 503 }, "retryable": { "const": true } } },
        { "required": ["code", "status", "retryable"], "properties": { "code": { "const": "INTERNAL_DATA_INTEGRITY_FAILURE" }, "status": { "const": 503 }, "retryable": { "const": true } } }
      ]
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/ErrorDisposition" }],
      "required": [
        "schema_version",
