{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdarchive:qa:screenshot-manifest-schema:v1",
  "title": "Graphic Design Archive QA Screenshot Manifest",
  "description": "Governance schema for release-pinned, rights-aware visual QA evidence. This schema does not authorize capture or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "captureSetId",
    "researchReleaseId",
    "researchManifestSha256",
    "visualRegistry",
    "generatedAt",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v1"
    },
    "captureSetId": {
      "type": "string",
      "minLength": 1
    },
    "researchReleaseId": {
      "type": "string",
      "minLength": 1
    },
    "researchManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "visualRegistry": {
      "description": "The visual-registry version and digest are atomic. Null means no visual registry was used.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visualRegistryVersion",
            "visualRegistrySha256"
          ],
          "properties": {
            "visualRegistryVersion": {
              "type": "string",
              "minLength": 1
            },
            "visualRegistrySha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commandReceipt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commandReceipt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverageStatus": {
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT_EVALUATED"
      ]
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "path",
        "sha256",
        "bytes",
        "fileExtension",
        "actualMimeType",
        "width",
        "height",
        "rightsProvenance",
        "oracle",
        "interactionCoverage",
        "accessibility"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^docs/qa/screenshots/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "fileExtension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9]+$"
        },
        "actualMimeType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "rightsProvenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pixelOrigin",
            "evidenceLocator",
            "effectiveDisposition"
          ],
          "properties": {
            "pixelOrigin": {
              "enum": [
                "PROJECT_AUTHORED",
                "THIRD_PARTY_REFERENCE_PRESENT",
                "MIXED",
                "UNKNOWN"
              ]
            },
            "evidenceLocator": {
              "type": [
                "string",
                "null"
              ]
            },
            "effectiveDisposition": {
              "enum": [
                "EVIDENCE_ALLOWED",
                "CITATION_ONLY",
                "LINK_ONLY",
                "TAKEDOWN_HOLD",
                "UNKNOWN"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oracleId",
            "oracleVersion",
            "expected",
            "observed",
            "status"
          ],
          "properties": {
            "oracleId": {
              "type": "string",
              "minLength": 1
            },
            "oracleVersion": {
              "type": "string",
              "minLength": 1
            },
            "expected": {
              "type": "string"
            },
            "observed": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/coverageStatus"
            }
          }
        },
        "interactionCoverage": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "KEYBOARD",
              "SCREEN_READER",
              "REDUCED_MOTION",
              "TOUCH",
              "SWIPE",
              "SCROLL",
              "SOURCE_DRAWER",
              "SEARCH",
              "MAP",
              "ERROR_STATE"
            ]
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyboard",
            "screenReader",
            "reducedMotion",
            "contrast",
            "touchTargets"
          ],
          "properties": {
            "keyboard": {
              "$ref": "#/$defs/coverageStatus"
            },
            "screenReader": {
              "$ref": "#/$defs/coverageStatus"
            },
            "reducedMotion": {
              "$ref": "#/$defs/coverageStatus"
            },
            "contrast": {
              "$ref": "#/$defs/coverageStatus"
            },
            "touchTargets": {
              "$ref": "#/$defs/coverageStatus"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
