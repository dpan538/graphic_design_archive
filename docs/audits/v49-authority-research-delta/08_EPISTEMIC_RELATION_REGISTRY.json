  "scope": "Epistemic routing, evidence, promotion and TRACE-projectability policy for every relation label observed in the frozen v48 full graph, plus the reserved zero-count influenced_by predicate.",
  "authorityBoundary": {
    "canonicalMigrationInput": "generated/public_surfaces_prefreeze_candidate_v48.json",
    "immutableReconciliationOnly": "data/prefreeze_candidate_v48.sqlite",
    "integrityEvidence": "frontend/public/data/trace-v48/manifest.json",
    "derivedProducts": [
      "frontend/public/data/trace-v48/atlas.json",
      "frontend/public/data/trace-v48/catalog.json",
      "frontend/public/data/trace-v48/neighborhoods/*.json"
    ],
    "derivedProductsMayCreateCanonicalClaimsOrRelations": false,
    "sqliteMayFillCandidateGaps": false
  },
  "interpretationRule": "A relation label selects an evidence route; it never by itself assigns a claim's epistemic class. A claim receives an epistemic class only when all required claimant, wording, source, locator and class-specific evidence are present and reviewed.",
  "epistemicClasses": {
    "documented_source_statement": {
      "definition": "A bounded statement of what an identified source or provider record says.",
      "requiredFields": [
        "source_or_claimant_id",
        "source_record_id",
        "preserved_wording_or_exact_structured_value",
        "exact_locator",
        "observation_or_access_context",
        "registered_predicate_mapping"
      ],
      "prohibitedImplication": "Documentation does not turn a provider statement into universal truth."
    },
    "scholarly_claim": {
      "definition": "A claimant-bound scholarly interpretation that can support, challenge or qualify a semantic relation while competing claims remain separate.",
      "requiredFields": [
        "claimant_agent_id",
        "cited_work_or_source_id",
        "exact_locator",
        "preserved_wording_or_licensed_excerpt_hash",
        "claim_date_or_version",
        "stance",
        "review_state"
      ],
      "prohibitedImplication": "Acceptance does not erase competing scholarship and does not imply causation."
    },
    "computed_association": {
      "definition": "A result produced by a named deterministic analysis run.",
      "requiredFields": [
        "analysis_run_id",
        "method_and_software_version_hash",
        "deterministic_parameters",
        "research_release_id",
        "research_manifest_sha256",
        "corpus_version_and_policy_hash",
        "subject_and_object",
        "score_unit_uncertainty_threshold",
        "output_hash"
      ],
      "prohibitedImplication": "Similarity, clustering, score, co-occurrence or layout is neither documented fact nor causation."
    },
    "causal_interpretation": {
      "definition": "A named claimant's explicitly sourced causal or influence interpretation.",
      "requiredFields": [
        "claimant_agent_id",
        "preserved_claimant_wording",
        "source_or_citation_id",
        "exact_locator",
        "typed_subject_and_object",
        "direction_and_scope",
        "temporal_qualification",
        "stance_and_competing_claims",
        "evidence_chain",
        "heightened_reviewer_decision",
        "relation_policy_version"
      ],
      "prohibitedImplication": "Chronology, geography, medium, source, similarity, theme, cluster or score never manufactures causation or influence."
    }
  },
  "evidenceProfiles": {
    "documented-source-v1": {
      "epistemicClassRoute": "documented_source_statement",
      "requires": [
        "typed subject and object",
        "source-bound exact field literal or preserved wording",
        "source record and exact locator",
        "registered predicate/domain/range mapping",
        "claim/evidence bridge and curator decision"
      ]
    },
    "computed-association-v1": {
      "epistemicClassRoute": "computed_association",
      "requires": [
        "typed subject and object",
        "complete analysis run identity",
        "method/software and deterministic parameters",
        "exact research release and corpus hashes",
        "score/unit/uncertainty/threshold and output hash",
        "reviewed promotion decision"
      ]
    },
    "unknown-relation-review-v1": {
      "epistemicClassRoute": null,
      "requires": [
        "approved relation registry entry",
        "typed domain and range",
        "explicit epistemic and evidence requirements",
        "source-bound occurrence and exact locator",
        "reviewer resolution without default family",
        "accepted claim/evidence path before semantic promotion"
      ]
    },
    "causal-influence-v1": {
      "epistemicClassRoute": "causal_interpretation",
      "requires": [
        "named claimant and preserved wording",
        "source/citation and exact locator",
        "typed subject and object with direction and scope",
        "temporal qualification and competing claims",
        "evidence chain and heightened review",
        "relation policy version"
      ]
    }
  },
