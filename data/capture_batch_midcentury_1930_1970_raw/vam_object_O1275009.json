    "marksAndInscriptions": [
      {
        "content": "There flows from Latin America to the United States a constant / torrent of money some $4,000 dollars per minute, $15 million / a day, $2 billion a year, $10 billion each five years. For each / $1,000 which leave us one dead body remains, a $1,000 per / death, that is the price of what is called imperialism.",
        "date": {
          "earliest": null,
          "latest": null,
          "text": ""
        },
        "description": "",
        "inscriber": {
          "association": {
            "id": "",
