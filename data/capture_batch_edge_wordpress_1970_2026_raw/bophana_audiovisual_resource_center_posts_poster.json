pz xkrqix3 x1sur9pj x1fey0fg x1s688f\" tabindex=\"0\" role=\"link\" href=\"https://www.facebook.com/reifoundation?__cft__[0]=AZY5gFDAKugU26jtGGwGH90l1hqcLIdhplIKHGYygtVxYdWVx1MzyQxImasIShb3H9Pcp9a5wbrDoxVm1pauDazjQFd7MdBhsxkY1ZKXUMRW1m2il20yzRPxbeQZoBPjeT9j2B0ud3-RlYXu9Q_K186OqEHD70sHUpXiFn_BkpzbPpoNK9r83CIodO5pYeAz3ec&amp;__tn__=-]K-R\"><span class=\"xt0psk2\"><span class=\"xjp7ctv\">Rei Foundation Limited</span></span></a></span>, the <span class=\"html-span xdj266r x14z9mp xat24cr x1lziwak xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs\"><a class=\"x1i10hfl xjbqb8w x1ejq31n x18oe1m7 x1sy0etr xstzfhl x972fbf x10w94by x1qhh985 x14e42zd x9f619 x1ypdohk xt0psk2 x3ct3a4 xdj266r x14z9mp xat24cr x1lziwak xexx8yu xyri2b x18d9i69 x1c1uobl x16tdsg8 x1hl2dhg xggy1nq x1a2a7pz xkrqix3 x1sur9pj x1fey0fg x1s688f\" tabindex=\"0\" role=\"link\" href=\"https://www.facebook.com/bophanacenter.cambodia?__cft__[0]=AZY5gFDAKugU26jtGGwGH90l1hqcLIdhplIKHGYygtVxYdWVx1MzyQxImasIShb3H9Pcp9a5wbrDoxVm1pauDazjQFd7MdBhsxkY1ZKXUMRW1m2il20yzRPxbeQZoBPjeT9j2B0ud3-RlYXu9Q_K186OqEHD70sHUpXiFn_BkpzbPpoNK9r83CIodO5pYeAz3ec&amp;__tn__=-]K-R\"><span class=\"xt0psk2\"><span class=\"xjp7ctv\">Bophana Center</span></span></a></span> (ARPAA) is implementing a project entitled “Enhancing the Preservation of Audiovisual Memory and Youth Empowerment” for a period of three (3) years, from November 2025 to October 2028.</p>\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/tff/1/16/1f3a5.png\" alt=\"🎥\" width=\"16\" height=\"16\" /></span><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t2d/1/16/1f3ac.png\" alt=\"🎬\" width=\"16\" height=\"16\" /></span> This project will provide scholarships to 12 (twelve) young people each year to participate in a Documentary Film and Multimedia Production Training Program.</p>\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t8d/1/16/2611.png\" alt=\"☑️\" width=\"16\" height=\"16\" /></span> Selection Criteria</p>\n<p dir=\"auto\">• Cambodian citizens, including Khmer, ethnic minorities, and indigenous peoples living in Cambodia</p>\n<p dir=\"auto\">• Aged between 18 and 30 years old</p>\n<p dir=\"auto\">• No criminal conviction</p>\n<p dir=\"auto\">• Strong interest in documenting and telling stories about Cambodia</p>\n<p dir=\"auto\">• Fully available to participate in all training sessions</p>\n<p dir=\"auto\">(Women and persons with disabilities are strongly encouraged to apply)</p>\n<p dir=\"auto\">\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t84/1/16/1f381.png\" alt=\"🎁\" width=\"16\" height=\"16\" /></span> Benefits for Selected Trainees</p>\n<p dir=\"auto\">• Free training and use of filming equipment</p>\n<p dir=\"auto\">• Health insurance coverage during the training period</p>\n<p dir=\"auto\">• Accommodation provided for trainees from provinces</p>\n<p dir=\"auto\">• Certificate of completion</p>\n<p dir=\"auto\">• Opportunities to showcase their works at national and international film festivals</p>\n<p dir=\"auto\">\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/tcc/1/16/1f4dd.png\" alt=\"📝\" width=\"16\" height=\"16\" /></span> How to Apply</p>\n<p dir=\"auto\">Please complete the application form via the following link:</p>\n<p dir=\"auto\"><span class=\"html-span xdj266r x14z9mp xat24cr x1lziwak xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs\"><a class=\"x1i10hfl xjbqb8w x1ejq31n x18oe1m7 x1sy0etr xstzfhl x972fbf x10w94by x1qhh985 x14e42zd x9f619 x1ypdohk xt0psk2 x3ct3a4 xdj266r x14z9mp xat24cr x1lziwak xexx8yu xyri2b x18d9i69 x1c1uobl x16tdsg8 x1hl2dhg xggy1nq x1a2a7pz xkrqix3 x1sur9pj x1fey0fg x1s688f\" tabindex=\"0\" role=\"link\" href=\"https://forms.gle/USfTyjaG6xNoFDD59?fbclid=IwZXh0bgNhZW0CMTAAYnJpZBExTlg3ZFZoSXBkd3dQQnZLU3NydGMGYXBwX2lkEDIyMjAzOTE3ODgyMDA4OTIAAR4dRljMGYlU9m0Fgmz3giMRci_4oy3DzE85HZaHw33CnGchRgbTRtYOIOLk-g_aem_3aJ7DuUzYyYlmaWXEG4MgQ\" target=\"_blank\" rel=\"nofollow noopener noreferrer\">https://forms.gle/USfTyjaG6xNoFDD59</a></span></p>\n<p dir=\"auto\">or collect the application form directly at the Bophana Audiovisual Resource Center, or scan the QR code on the poster below.</p>\n<p dir=\"auto\">\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t7e/1/16/1f4c5.png\" alt=\"📅\" width=\"16\" height=\"16\" /></span> Application deadline: No later than February 22, 2026</p>\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t7e/1/16/1f4c5.png\" alt=\"📅\" width=\"16\" height=\"16\" /></span> Training period: From March 9, 2026 to March 8, 2027</p>\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/tb5/1/16/23f1.png\" alt=\"⏱️\" width=\"16\" height=\"16\" /></span> Training schedule: Monday to Friday (8 hours per day)</p>\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t2d/1/16/1f4cd.png\" alt=\"📍\" width=\"16\" height=\"16\" /></span> Training location: Bophana Center, Phnom Penh</p>\n<p dir=\"auto\">\n<p dir=\"auto\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\"><img loading=\"lazy\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t4d/1/16/1f4de.png\" alt=\"📞\" width=\"16\" height=\"16\" /></span> For more information: Please contact 010 775 151 or 017 672 926</p>\n<p dir=\"auto\">(The Bophana Audiovisual Resource Center reserves the right to make changes to the program if necessary.)</p>\n"
    },
