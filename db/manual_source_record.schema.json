{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-gd-history.local/schemas/manual_source_record.schema.json",
  "title": "Manual Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordStatus",
    "captureMethod",
    "source",
    "sourceMetadata",
    "rights",
    "citation",
    "classifications"
  ],
  "properties": {
    "recordStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "source_reviewed",
        "rights_reviewed",
        "ingested",
        "normalized",
        "classified",
        "relation_reviewed",
        "published",
        "deprecated",
        "blocked"
      ]
    },
    "captureMethod": {
      "type": "string",
      "enum": ["manual"]
    },
    "enteredBy": {
      "type": "string"
    },
    "enteredDate": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceName", "sourceRecordUrl", "accessDate"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^SRC[0-9]{3,}$"},
        "sourceName": {"type": "string", "minLength": 1},
        "sourceRecordUrl": {"type": "string", "format": "uri"},
        "sourceIdentifier": {"type": "string"},
        "accessDate": {"type": "string", "format": "date"},
        "sourceTermsReviewId": {"type": "string"}
      }
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTitle"],
      "properties": {
        "sourceTitle": {"type": "string", "minLength": 1},
        "sourceCreator": {"type": "string"},
        "sourceCreatorRole": {"type": "string"},
        "sourceDateText": {"type": "string"},
        "sourcePlaceText": {"type": "string"},
        "sourceMediumText": {"type": "string"},
        "sourceObjectType": {"type": "string"},
        "sourceDimensions": {"type": "string"},
        "sourceHoldingInstitution": {"type": "string"},
        "sourceCollection": {"type": "string"},
        "sourceDescription": {"type": "string"},
        "sourceRightsText": {"type": "string"},
        "sourceRightsUri": {"type": "string"},
        "sourceCreditLine": {"type": "string"}
      }
    },
    "normalizedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalizedTitle": {"type": "string"},
        "normalizedDateStart": {"type": ["integer", "null"]},
        "normalizedDateEnd": {"type": ["integer", "null"]},
        "normalizedPlace": {"type": "string"},
        "normalizedCreatorEntityId": {"type": "string"},
        "normalizedInstitutionEntityId": {"type": "string"},
        "normalizedMediumIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^MT[0-9]{3,}$"}
        },
        "normalizedObjectTypeIds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "historicalNodeIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^HN[0-9]{3,}$"}
        },
        "movementIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^MV[0-9]{3,}$"}
        },
        "themeTerms": {
          "type": "array",
          "items": {"type": "string"}
        },
        "language": {"type": "string"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rightsState", "imageUsePolicy", "localCopyPermitted", "rightsBasis"],
      "properties": {
        "rightsState": {
          "type": "string",
          "enum": [
            "metadata_open",
            "metadata_limited",
            "image_open",
            "image_embed_only",
            "thumbnail_only",
            "link_only",
            "unknown",
            "do_not_ingest"
          ]
        },
        "imageUsePolicy": {
          "type": "string",
          "enum": [
            "metadata_only",
            "link_only",
            "thumbnail_only",
            "source_viewer_only",
            "iiif_embed_only",
            "full_image_allowed",
            "do_not_display"
          ]
        },
        "metadataPolicy": {"type": "string"},
        "thumbnailPolicy": {"type": "string"},
        "fullImagePolicy": {"type": "string"},
        "iiifEmbedPolicy": {"type": "string"},
        "localCopyPermitted": {"type": "boolean"},
        "rightsBasis": {"type": "string", "minLength": 1},
        "rightsReviewRequired": {"type": "boolean"},
        "rightsReviewer": {"type": "string"},
        "rightsReviewDate": {"type": "string", "format": "date"},
        "rightsNotes": {"type": "string"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationText", "citationUrl", "accessDate"],
      "properties": {
        "citationText": {"type": "string", "minLength": 1},
        "citationStyle": {"type": "string"},
        "citationUrl": {"type": "string", "format": "uri"},
        "accessDate": {"type": "string", "format": "date"}
      }
    },
    "publicationDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePresenceCode", "imagePresenceBasis"],
      "properties": {
        "imagePresenceCode": {
          "type": "string",
          "enum": ["IMG00", "IMG01", "IMG02", "IMG03", "IMG04"]
        },
        "imagePresenceBasis": {"type": "string", "minLength": 1},
        "imageFrameBehavior": {
          "type": "string",
          "enum": [
            "empty_rights_frame",
            "thumbnail_frame",
            "source_viewer_frame",
            "open_image_frame",
            "no_image_frame"
          ]
        },
        "imageSizePolicy": {
          "type": "string",
          "enum": ["template_defined", "not_applicable"]
        },
        "layoutNote": {"type": "string"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceImageUrl": {"type": "string", "format": "uri"},
        "iiifManifestUrl": {"type": "string", "format": "uri"},
        "iiifCanvasId": {"type": "string"},
        "thumbnailUrl": {"type": "string", "format": "uri"},
        "imageRightsUri": {"type": "string"},
        "imageRightsLabel": {"type": "string"},
        "creditLine": {"type": "string"},
        "localCopyPermitted": {"type": "boolean"}
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classificationType", "classificationValue", "source", "confidence"],
        "properties": {
          "classificationType": {"type": "string"},
          "classificationValue": {"type": "string"},
          "source": {
            "type": "string",
            "enum": ["source_metadata", "controlled_vocabulary", "editorial_judgment"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          },
          "reviewer": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectEntityId",
          "predicate",
          "objectEntityId",
          "assertionType",
          "confidence"
        ],
        "properties": {
          "subjectEntityId": {"type": "string"},
          "predicate": {"type": "string"},
          "objectEntityId": {"type": "string"},
          "evidenceSourceRecordUrl": {"type": "string", "format": "uri"},
          "citationId": {"type": "string"},
          "assertionType": {
            "type": "string",
            "enum": ["source_statement", "editorial_inference"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          },
          "note": {"type": "string"}
        }
      }
    },
    "uncertaintyNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "issue"],
        "properties": {
          "field": {"type": "string"},
          "issue": {"type": "string"},
          "displayNote": {"type": "string"},
          "internalNote": {"type": "string"}
        }
      }
    }
  }
}
